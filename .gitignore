# pixi environments
.pixi/*
!.pixi/config.toml

# Python
__pycache__/
*.pyc
*.egg-info/

# pytest
.pytest_cache/

# mypy
.mypy_cache/

# Run outputs and training data (regenerated by scripts/select_training_set.py,
# scripts/select_mnsol_set.py and scripts/run_training_set.py).  The IUPAC and
# MNSol data are distributed under their own licenses, so neither they nor the
# sets selected from them are tracked, including earlier selections and the
# pKa-labelled structure grids select_training_set.py draws.
training_set*.csv
training_set*.png
mnsol_set.csv
MNSolDatabase*/
train_set/
*_output/
timer.dat

# PCMSolver scratch files (written to the cwd by the Psi4 backend when using PCM)
@pcmsolver.*
PEDRA.OUT*
cavity.off*
cavity.npz
pcmsolver.*.inp*

# Editor / OS
.DS_Store
.idea/
